<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_login_gradient"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/remedi_check_title"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/remedi_check_subtitle"
            android:textSize="15sp"
            android:textColor="#D6EAF8"
            android:layout_marginBottom="20dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/sugar_reminder_label"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF" />

        <EditText
            android:id="@+id/etSugarTime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/choose_time_hint"
            android:clickable="true"
            android:focusable="false"
            android:inputType="none"
            android:textColor="@color/deep_plum"
            android:textColorHint="#5D6D7E"
            android:backgroundTint="#FFFFFF"
            android:padding="12dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="10dp" />

        <Button
            android:id="@+id/btnSugarReminder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/set_sugar_btn"
            android:textStyle="bold"
            android:textColor="@color/deep_plum"
            android:backgroundTint="#FFFFFF"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/pressure_reminder_label"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF" />

        <EditText
            android:id="@+id/etPressureTime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/choose_time_hint"
            android:clickable="true"
            android:focusable="false"
            android:inputType="none"
            android:textColor="@color/deep_plum"
            android:textColorHint="#5D6D7E"
            android:backgroundTint="#FFFFFF"
            android:padding="12dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="10dp" />

        <Button
            android:id="@+id/btnPressureReminder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/set_pressure_btn"
            android:textStyle="bold"
            android:textColor="@color/deep_plum"
            android:backgroundTint="#FFFFFF"
            android:layout_marginBottom="20dp" />

        <TextView
            android:id="@+id/tvSavedHealthReminders"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/saved_reminders_title"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="8dp" />

        <ListView
            android:id="@+id/listHealthReminders"
            android:layout_width="match_parent"
            android:layout_height="260dp"
            android:background="#FFFFFF" />

        <TextView
            android:id="@+id/tvMeasurementHistoryTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/sugar_pressure_history"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:layout_marginTop="22dp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvMeasurementHistorySubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/history_subtitle"
            android:textSize="14sp"
            android:textColor="#D6EAF8"
            android:layout_marginBottom="12dp" />

        <EditText
            android:id="@+id/etSugarValue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/sugar_value_hint"
            android:inputType="numberDecimal"
            android:textColor="@color/deep_plum"
            android:textColorHint="#5D6D7E"
            android:backgroundTint="#FFFFFF"
            android:padding="12dp"
            android:layout_marginBottom="10dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="10dp">

            <EditText
                android:id="@+id/etSystolicPressure"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="@string/systolic_hint"
                android:inputType="numberDecimal"
                android:textColor="@color/deep_plum"
                android:textColorHint="#5D6D7E"
                android:backgroundTint="#FFFFFF"
                android:padding="12dp" />

            <EditText
                android:id="@+id/etDiastolicPressure"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:hint="@string/diastolic_hint"
                android:inputType="numberDecimal"
                android:textColor="@color/deep_plum"
                android:textColorHint="#5D6D7E"
                android:backgroundTint="#FFFFFF"
                android:padding="12dp" />
        </LinearLayout>

        <EditText
            android:id="@+id/etMeasurementNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/measurement_note_hint"
            android:inputType="textCapSentences|textMultiLine"
            android:minLines="2"
            android:textColor="@color/deep_plum"
            android:textColorHint="#5D6D7E"
            android:backgroundTint="#FFFFFF"
            android:padding="12dp"
            android:layout_marginBottom="10dp" />

        <Button
            android:id="@+id/btnSaveMeasurement"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/save_measurement_btn"
            android:textStyle="bold"
            android:textColor="@color/deep_plum"
            android:backgroundTint="#FFFFFF"
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/tvMeasurementHelp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/history_help"
            android:textSize="13sp"
            android:textColor="#D6EAF8"
            android:layout_marginBottom="8dp" />

        <ListView
            android:id="@+id/listHealthMeasurements"
            android:layout_width="match_parent"
            android:layout_height="320dp"
            android:background="#FFFFFF"
            android:divider="#BBDEFB"
            android:dividerHeight="1dp" />

    </LinearLayout>
</ScrollView>