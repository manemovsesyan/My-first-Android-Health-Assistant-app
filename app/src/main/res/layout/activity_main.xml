<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/deep_plum">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="24dp">

        <TextView
            android:id="@+id/appTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Health Assistant"
            android:textSize="30sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:layout_marginTop="30dp" />

        <TextView
            android:id="@+id/appSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Smart support for your health"
            android:textSize="16sp"
            android:textColor="#D6EAF8"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="24dp" />

        <ImageView
            android:id="@+id/appLogo"
            android:layout_width="160dp"
            android:layout_height="160dp"
            android:src="@drawable/health_icon"
            android:contentDescription="App Logo"
            android:layout_marginBottom="30dp" />

        <Button
            android:id="@+id/btnMedication"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Medication Reminder"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/deep_plum"
            android:backgroundTint="#FFFFFF"
            android:layout_marginBottom="16dp"
            android:padding="16dp" />

        <Button
            android:id="@+id/btnSugar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Blood Sugar Tracker"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/deep_plum"
            android:backgroundTint="#FFFFFF"
            android:layout_marginBottom="16dp"
            android:padding="16dp" />

        <Button
            android:id="@+id/btnEmergency"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Emergency Contacts"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/deep_plum"
            android:backgroundTint="#FFFFFF"
            android:layout_marginBottom="16dp"
            android:padding="16dp" />

        <Button
            android:id="@+id/btnNotes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Daily Notes"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/deep_plum"
            android:backgroundTint="#FFFFFF"
            android:padding="16dp" />

    </LinearLayout>
</ScrollView>
