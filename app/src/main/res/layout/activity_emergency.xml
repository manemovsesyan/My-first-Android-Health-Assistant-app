<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_login_gradient"
    android:fillViewport="true"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvEmergencyTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Emergency Contacts"
            android:textColor="#FFFFFF"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvEmergencySubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="20dp"
            android:text="Save trusted phone numbers and call them quickly when you feel very bad."
            android:textColor="#D6EAF8"
            android:textSize="15sp" />

        <EditText
            android:id="@+id/etContactName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:backgroundTint="#FFFFFF"
            android:hint="Contact name (example: Doctor, Mom)"
            android:inputType="textCapWords"
            android:padding="12dp"
            android:textColor="@color/deep_plum"
            android:textColorHint="#5D6D7E" />

        <EditText
            android:id="@+id/etContactPhone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:backgroundTint="#FFFFFF"
            android:hint="Phone number"
            android:inputType="phone"
            android:padding="12dp"
            android:textColor="@color/deep_plum"
            android:textColorHint="#5D6D7E" />

        <Button
            android:id="@+id/btnSaveContact"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:backgroundTint="#FFFFFF"
            android:padding="14dp"
            android:text="Save Emergency Contact"
            android:textColor="@color/deep_plum"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnCallPrimaryContact"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:backgroundTint="#FFCDD2"
            android:padding="16dp"
            android:text="Call First Contact Now"
            android:textColor="@color/deep_plum"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvEmergencyHelp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="Tap a contact to call. Long press a contact to delete it."
            android:textColor="#D6EAF8"
            android:textSize="13sp" />

        <ListView
            android:id="@+id/listEmergencyContacts"
            android:layout_width="match_parent"
            android:layout_height="360dp"
            android:background="#FFFFFF"
            android:divider="#BBDEFB"
            android:dividerHeight="1dp" />

    </LinearLayout>
</ScrollView>
